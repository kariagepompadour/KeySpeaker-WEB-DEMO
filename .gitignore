# KeySpeaker (USB Speaker & BLE Keyboard) — files that should not be published.
# This only affects what `git add` picks up. Before publishing, check
# `git status` and `git diff --cached --name-only`.

# Arduino build outputs (regenerated by a build; merged images also contain a bootloader and partition table)
build/
*.elf
*.map
*.merged.bin
*.bootloader.bin
*.partitions.bin

# OS / editor clutter
.DS_Store
Thumbs.db
desktop.ini
.idea/
.vscode/
*.log

# Hand-over notes between assistants (local only, not for publishing)
HANDOFF_*.md
